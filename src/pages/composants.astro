---
// Planche de composants — page interne, noindex.
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelArt from '../components/PixelArt.astro';
import Mascot from '../components/Mascot.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsCard from '../components/NewsCard.astro';
import Terminal from '../components/Terminal.astro';
import { SITE } from '../data/site';
import type { ArtName, Ramp } from '../lib/pixel';

const swatches = [
  { bg: '#151524', label: '--ink #151524' },
  { bg: '#F2F1E8', label: '--cream #F2F1E8', border: true },
  { bg: '#FFFFFF', label: '--paper #FFFFFF', border: true },
  { bg: '#FEC63A', label: 'ambre #FEC63A' },
  { bg: 'var(--note)', label: 'note · annotations' },
];
const sunset = ['#FFAF01', '#FF8204', '#FA500F', '#E61300', '#C4001D · sunset + grain'];
const ramps = [
  { label: 'Réseau · bleu', c: ['#044298', '#0082E6', '#55B3FB', '#B9DAFF'] },
  { label: 'Supervision / backup · vert', c: ['#005737', '#318E68', '#44BA82', '#94EACC'] },
  { label: 'Sécurité · sunset', c: ['#C4001D', '#FA500F', '#FF8204', '#FFAF01'] },
];
const icons: { art: ArtName; ramp: Ramp; label: string; rampLabel: string }[] = [
  { art: 'infra', ramp: 'blue', label: 'Infra & virtu', rampLabel: 'bleu' },
  { art: 'backup', ramp: 'green', label: 'Sauvegarde & PRA', rampLabel: 'vert' },
  { art: 'lock', ramp: 'sunset', label: 'Réseau & sécu', rampLabel: 'sunset' },
  { art: 'chip', ramp: 'pop', label: 'Automatisation & IA', rampLabel: 'note / ambre' },
];
const illus: { art: ArtName; ramp: Ramp; label: string }[] = [
  { art: 'migrate', ramp: 'green', label: 'Migration' },
  { art: 'network', ramp: 'blue', label: 'Tailscale' },
  { art: 'chip', ramp: 'pop', label: 'IA locale' },
  { art: 'ticket', ramp: 'green', label: 'GLPI 11' },
  { art: 'firmware', ramp: 'sunset', label: 'Firmware HPE' },
  { art: 'wipe', ramp: 'sunset', label: 'DataWipe' },
];
const types = [
  { label: 'Display · Geist 500 · 112 / 0.93 · −4.5 %', cls: 'h-display', text: 'Infra solide.' },
  { label: 'H2 · Geist 500 · 72 / 0.98', cls: 'h2', text: 'Un seul standard.' },
  { label: 'H3 · Geist 500 · 46 / 1', cls: 'h3', text: 'Fermé par défaut.' },
  { label: 'Corps · Geist 400 · 17 / 1.5', cls: 'cp-body', text: 'Une sauvegarde ne compte que si elle a été restaurée. Je teste, je chronomètre, je documente.' },
  { label: 'Micro · Geist Mono · 11 · +8 %', cls: 'micro cp-micro', text: '02 — Projets phares' },
];
---
<BaseLayout title="Planche de composants" noindex footerLinks={[{ href: '/', label: 'Accueil' }, { href: '/projets', label: 'Projets' }, { href: '/veille', label: 'Veille' }]}>
  <div class="cp container">
    <header class="cp__head">
      <div class="cp__headl">
        <span class="micro">Portfolio — planche de composants · v1</span>
        <h1 class="h-display cp__h1" data-rt>
          <span class="rl-wrap"><span class="rl" data-rl>Un système.</span></span>
          <span class="rl-wrap"><span class="rl" data-rl>Peu de pièces.</span></span>
        </h1>
      </div>
      <div class="cp__headr">
        <a class="btn btn--sm btn--secondary" href="/">Accueil</a>
        <a class="btn btn--sm btn--secondary" href="/projets/migration-unraid-proxmox">Page projet</a>
      </div>
    </header>

    <!-- 01 Couleurs -->
    <section class="cp__sec" aria-labelledby="cp-01">
      <h2 id="cp-01" class="micro cp__label">01 — Couleurs</h2>
      <div class="cp__swatches">
        {swatches.map((s) => (
          <div class="cp__sw">
            <div class:list={['cp__chip', { 'cp__chip--b': s.border }]} style={`background:${s.bg}`}></div>
            <span class="cp__mono">{s.label}</span>
          </div>
        ))}
      </div>
      <div class="cp__sunset">
        <span class="grain"></span>
        {sunset.map((c) => <div class="cp__sunc"><span class="cp__mono cp__sunl">{c}</span></div>)}
      </div>
      <div class="cp__ramps">
        {ramps.map((r) => (
          <div class="cp__ramp">
            <div class="cp__rampbar">{r.c.map((c) => <span style={`background:${c}`}></span>)}</div>
            <span class="micro cp__rampl">{r.label}</span>
          </div>
        ))}
      </div>
      <p class="micro cp__note">#FA500F sur crème ≈ 3:1 → titres, icônes et flèches uniquement. Texte courant en --ink.</p>
    </section>

    <!-- 02 Typographie -->
    <section class="cp__sec" aria-labelledby="cp-02">
      <h2 id="cp-02" class="micro cp__label">02 — Typographie</h2>
      <div class="cp__types">
        {types.map((t) => (
          <div class="cp__type">
            <span class="micro cp__typel">{t.label}</span>
            <p class={t.cls}>{t.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 03 Emblème -->
    <section class="cp__sec" aria-labelledby="cp-03">
      <h2 id="cp-03" class="micro cp__label">03 — Emblème · baie 3U + prompt &gt;_ · grille 20 × 20</h2>
      <div class="cp__emb">
        <div class="cp__tile cp__tile--paper"><span class="micro micro--cell cp__tl">Construction</span><PixelArt art="emblem" px={8} grid="dark" /></div>
        <div class="cp__tile cp__tile--cream"><span class="micro micro--cell cp__tl">Sunset · défaut</span><PixelArt art="emblem" px={8} /></div>
        <div class="cp__tile cp__tile--cream"><span class="micro micro--cell cp__tl">Encre</span><PixelArt art="emblem" variant="ink" px={8} /></div>
        <div class="cp__tile cp__tile--ink"><span class="micro micro--cell cp__tl">Blanc</span><PixelArt art="emblem" variant="white" px={8} /></div>
        <div class="cp__tile cp__tile--sunset"><span class="grain"></span><span class="micro micro--cell cp__tl cp__tl--ink">Blanc sur aplat</span><PixelArt art="emblem" variant="white" px={8} class="cp__z" /></div>
      </div>
      <div class="cp__lockups">
        <div class="cp__lock cp__lock--light">
          <div class="cp__lockup"><PixelArt art="emblem" px={2.4} /><span class="cp__word">{SITE.name}</span></div>
          <span class="micro micro--cell">Lockup · wordmark --ink</span>
        </div>
        <div class="cp__lock cp__lock--dark">
          <div class="cp__lockup"><PixelArt art="emblem" px={2.4} /><span class="cp__word">{SITE.name}</span></div>
          <span class="micro micro--cell cp__mdark">Variante sombre</span>
        </div>
        <div class="cp__lock cp__lock--light cp__sizes">
          <PixelArt art="emblem" px={4} /><PixelArt art="emblem" px={2} /><PixelArt art="emblem" px={1.2} /><PixelArt art="emblem" px={0.8} />
          <span class="micro micro--cell">80 · 40 · 24 · 16</span>
        </div>
      </div>
    </section>

    <!-- 04 Icônes -->
    <section class="cp__sec" aria-labelledby="cp-04">
      <h2 id="cp-04" class="micro cp__label">04 — Icônes des 4 domaines · 160 × 160 · modules de 8 px</h2>
      <div class="cp__icons">
        {icons.map((i) => (
          <div class="cp__icon">
            <PixelArt art={i.art} ramp={i.ramp} px={8} />
            <div class="cp__iconl"><span class="micro micro--cell cp__fgl">{i.label}</span><span class="micro micro--cell">{i.rampLabel}</span></div>
          </div>
        ))}
      </div>
      <div class="cp__minis">
        <span class="micro micro--cell">Encre · 40 px</span>
        {icons.map((i) => <PixelArt art={i.art} variant="ink" px={2} />)}
        <span class="cp__sep" aria-hidden="true"></span>
        <span class="micro micro--cell">Couleur · 24 px</span>
        {icons.map((i) => <PixelArt art={i.art} ramp={i.ramp} px={1.2} />)}
      </div>
    </section>

    <!-- 05 Illustrations -->
    <section class="cp__sec" aria-labelledby="cp-05">
      <h2 id="cp-05" class="micro cp__label">05 — Illustrations projets · même famille</h2>
      <div class="cp__illus">
        {illus.map((i) => (
          <div class="cp__ill"><PixelArt art={i.art} ramp={i.ramp} px={6} /><span class="micro micro--cell cp__fgl">{i.label}</span></div>
        ))}
      </div>
    </section>

    <!-- 06 Mascotte -->
    <section class="cp__sec" aria-labelledby="cp-06">
      <h2 id="cp-06" class="micro cp__label">06 — Mascotte · 16 × 16 · 3 frames · 4 i/s · figée si prefers-reduced-motion</h2>
      <div class="cp__masc">
        <div class="cp__mascbig"><Mascot px={8} /><span class="micro micro--cell cp__fgl">En boucle · a → b → a → c</span></div>
        <div class="cp__frames">
          <div class="cp__frame"><PixelArt art="mascot-a" px={6} grid="dark" /><span class="micro micro--cell cp__fgl">a · repos</span></div>
          <div class="cp__frame"><PixelArt art="mascot-b" px={6} grid="dark" /><span class="micro micro--cell cp__fgl">b · saut, regard</span></div>
          <div class="cp__frame"><PixelArt art="mascot-c" px={6} grid="dark" /><span class="micro micro--cell cp__fgl">c · clignement</span></div>
        </div>
      </div>
    </section>

    <!-- 07 Boutons -->
    <section class="cp__sec" aria-labelledby="cp-07">
      <h2 id="cp-07" class="micro cp__label">07 — Boutons · radius 6 · hauteur 40 / 48 / 52</h2>
      <div class="cp__btns">
        <div class="cp__panel cp__panel--cream">
          <span class="micro micro--cell">Sur crème</span>
          <div class="cp__row">
            <a class="btn btn--primary" href="/#contact">Me contacter <span class="btn__arrow">→</span></a>
            <a class="btn btn--secondary" href={SITE.cv}>CV <span class="cp__pdf">PDF</span></a>
          </div>
          <div class="cp__row">
            <a class="link-arrow" href="/projets">Lien fléché <span class="arrow">→</span></a>
            <button type="button" class="btn-square btn-square--secondary" aria-label="Précédent">←</button>
            <button type="button" class="btn-square btn-square--primary" aria-label="Suivant">→</button>
          </div>
        </div>
        <div class="cp__panel cp__panel--ink">
          <span class="micro micro--cell cp__mdark">Sur encre</span>
          <div class="cp__row">
            <a class="btn cp__btn-inv" href="/#contact">Me contacter <span class="btn__arrow">→</span></a>
            <a class="btn cp__btn-ghost" href={SITE.cv}>CV</a>
          </div>
          <div class="cp__row"><a class="link-arrow" href="/projets">Lien fléché <span class="arrow">→</span></a></div>
        </div>
        <div class="cp__panel cp__panel--sunset">
          <span class="grain"></span>
          <span class="micro micro--cell cp__tl--ink cp__z">Sur sunset · CTA</span>
          <div class="cp__row cp__z">
            <a class="btn btn--lg cp__btn-ink" href="/#contact">Me contacter <span class="btn__arrow">→</span></a>
            <a class="btn btn--lg cp__btn-white" href={SITE.cv}>Télécharger le CV</a>
          </div>
        </div>
      </div>
      <div class="cp__states">
        <span class="micro micro--cell">États</span>
        <div class="cp__state"><span class="btn btn--sm cp__btn-ink">Repos</span><span class="cp__mono">100 %</span></div>
        <div class="cp__state"><span class="btn btn--sm cp__btn-ink" style="opacity:.86">Survol</span><span class="cp__mono">86 %</span></div>
        <div class="cp__state"><span class="btn btn--sm cp__btn-ink" style="box-shadow:var(--focus-ring)">Focus</span><span class="cp__mono">anneau #0082E6</span></div>
        <div class="cp__state"><span class="btn btn--sm" aria-disabled="true">Désactivé</span><span class="cp__mono">cream −10 %</span></div>
      </div>
    </section>

    <!-- 08 Micro-labels & grille -->
    <section class="cp__sec" aria-labelledby="cp-08">
      <h2 id="cp-08" class="micro cp__label">08 — Micro-labels &amp; grille</h2>
      <div class="cp__mg">
        <div class="cp__mlabels">
          <span class="micro">03 — Ce que je fais</span>
          <span class="micro cp__inl"><span class="sq" style="background:#0082E6"></span>Réseau</span>
          <span class="tag cp__tagself">Diplôme</span>
        </div>
        <div class="cp__gridp">
          {Array.from({ length: 18 }, (_, i) => {
            const fills: Record<number, string> = { 1: '#FFAF01', 7: '#FF8204', 8: '#FA500F', 14: '#E61300', 15: '#C4001D' };
            return (
              <div class="cp__gcell" style={fills[i] ? `background:${fills[i]}` : undefined}>
                {i === 0 && <span class="micro micro--cell">A1</span>}
                {i === 3 && <span class="micro micro--cell">Fig. 03.1</span>}
                {i === 15 && <span class="micro micro--cell cp__white">ACK</span>}
              </div>
            );
          })}
          <div class="arc cp__garc"></div>
          <span class="micro micro--cell cp__gvert">Infra — 01</span>
          <span class="micro micro--cell cp__gbr">Filets 1 px · 10 %</span>
        </div>
      </div>
    </section>

    <!-- 09 Cartes -->
    <section class="cp__sec" aria-labelledby="cp-09">
      <h2 id="cp-09" class="micro cp__label">09 — Cartes · repos / survol (survolez la première)</h2>
      <div class="cp__cards">
        <ProjectCard href="/projets/migration-unraid-proxmox" fig="Fig. 02.1" legende="Unraid → Proxmox" art="migrate" ramp="green" dot="#318E68" categorie="Stockage · ZFS" titre="Migration homelab Unraid → Proxmox VE / ZFS" impact="~9 To transférés à distance, sans accès physique à la machine." pied="Étude de cas" />
        <ProjectCard href="/projets?domaine=reseau" fig="État survol · figé" legende="3 subnet routers" art="network" ramp="blue" dot="#0082E6" categorie="Réseau" titre="Réseau multi-sites Tailscale + reverse proxy" impact="Trois sites reliés, un reverse proxy qui bascule seul si un site tombe." pied="Homelab" forceHover />
        <div class="cp__newsw"><NewsCard href="/#parcours" type="News · Diplôme" date="2026" texte="Licence cybersécurité obtenue" /></div>
      </div>
    </section>

    <!-- 10 Terminal -->
    <section class="cp__sec cp__sec--last" aria-labelledby="cp-10">
      <h2 id="cp-10" class="micro cp__label">10 — Terminal interactif · live (whoami, ls projets, cat stack, ping contact, help)</h2>
      <div class="cp__tty"><Terminal autoDemo={false} /></div>
    </section>
  </div>
</BaseLayout>

<style>
  .cp { padding-top: clamp(40px, 5vw, 56px); }
  .cp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line2);
  }
  .cp__headl { display: flex; flex-direction: column; gap: 20px; }
  .cp__h1 { font-size: clamp(54px, 6.4vw, 96px); }
  .cp__headr { display: flex; gap: 8px; }

  .cp__sec { padding-top: clamp(56px, 6vw, 80px); display: flex; flex-direction: column; gap: 20px; }
  .cp__sec--last { padding-bottom: clamp(72px, 9vw, 120px); }
  .cp__label { margin-bottom: 10px; }
  .cp__mono { font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; }
  .cp__fgl { color: var(--fg); }
  .cp__z { position: relative; z-index: 2; }

  /* 01 */
  .cp__swatches { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .cp__sw { display: flex; flex-direction: column; gap: 10px; }
  .cp__chip { height: 96px; border-radius: 6px; }
  .cp__chip--b { border: 1px solid var(--line2); }
  .cp__sunset {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    min-height: 180px;
    border-radius: 8px;
    overflow: hidden;
    background: linear-gradient(90deg, #FFAF01, #FF8204 25%, #FA500F 50%, #E61300 75%, #C4001D);
  }
  .cp__sunc { position: relative; z-index: 2; padding: 12px; border-right: 1px solid rgba(255, 255, 255, .22); }
  .cp__sunc:last-child { border-right: 0; }
  .cp__sunl { color: #151524; }
  .cp__sunc:nth-child(n+5) .cp__sunl { color: #FFFFFF; }
  .cp__ramps { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
  .cp__ramp { display: flex; flex-direction: column; gap: 10px; }
  .cp__rampbar { display: grid; grid-template-columns: repeat(4, 1fr); height: 56px; border-radius: 6px; overflow: hidden; }
  .cp__rampl { color: var(--fg); }
  .cp__note { margin-top: 8px; }

  /* 02 */
  .cp__types { border-top: 1px solid var(--line); }
  .cp__type {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 32px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .cp__typel { flex: 0 0 200px; }
  .cp__type > p { flex: 1 1 400px; min-width: 0; }
  .cp-body { font-size: 17px; line-height: 1.5; max-width: 34em; }
  .cp-micro { color: var(--fg); }

  /* 03 */
  .cp__emb { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .cp__tile {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 8px;
    overflow: hidden;
  }
  .cp__tile--paper { background: #FFFFFF; border: 1px solid var(--line); }
  .cp__tile--cream { background: #F2F1E8; border: 1px solid rgba(21, 21, 36, .16); }
  .cp__tile--ink { background: #151524; }
  .cp__tile--sunset { background: var(--sunset-hero); }
  .cp__tile--paper .micro, .cp__tile--cream .micro { color: #4A4A5C; }
  .cp__tile--ink .micro { color: #F2F1E8; }
  .cp__tl { position: absolute; left: 12px; top: 12px; z-index: 2; }
  .cp__tl--ink { color: #151524 !important; }
  .cp__lockups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 12px; }
  @media (min-width: 1100px) { .cp__lockups { grid-template-columns: 1.2fr 1.2fr 1fr; } }
  .cp__lock {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 20px;
    padding: 28px 30px;
    border-radius: 8px;
    min-height: 136px;
  }
  .cp__lock--light { background: var(--card); border: 1px solid var(--line); color: var(--fg); }
  .cp__lock--dark { background: #151524; color: #F2F1E8; }
  .cp__lockup { display: flex; align-items: center; gap: 14px; }
  .cp__word { font-size: 26px; font-weight: 600; letter-spacing: -.02em; }
  .cp__mdark { color: #A9A89F; }
  .cp__sizes { justify-content: flex-start; align-items: flex-end; }

  /* 04 */
  .cp__icons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .cp__icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: 48px 20px 30px;
    border-right: 1px solid var(--line);
    margin-right: -1px;
  }
  .cp__iconl { align-self: stretch; display: flex; justify-content: space-between; gap: 12px; }
  .cp__minis {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 28px;
    padding: 20px 24px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .cp__sep { width: 1px; height: 32px; background: var(--line2); }

  /* 05 */
  .cp__illus { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .cp__ill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: 28px 12px 20px;
    background: var(--soft);
    border-radius: 8px;
  }

  /* 06 */
  .cp__masc { display: flex; flex-wrap: wrap; gap: 12px; }
  .cp__mascbig {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 32px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .cp__frames {
    flex: 2 1 480px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    border: 1px solid var(--line2);
    border-radius: 8px;
    overflow: hidden;
  }
  .cp__frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 24px 12px;
    border-right: 1px solid var(--line2);
    margin-right: -1px;
  }

  /* 07 */
  .cp__btns { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; }
  .cp__panel {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    border-radius: 8px;
  }
  .cp__panel--cream { background: #F2F1E8; border: 1px solid rgba(21, 21, 36, .16); color: #151524; }
  .cp__panel--cream .micro { color: #4A4A5C; }
  .cp__panel--ink { background: #151524; color: #F2F1E8; }
  .cp__panel--sunset { background: linear-gradient(30deg, #C4001D 0%, #E61300 32%, #FA500F 58%, #FF8204 80%, #FFAF01 100%); }
  .cp__panel--cream .btn--primary { background: #151524; color: #F2F1E8; }
  .cp__panel--cream .btn--secondary { color: #151524; border-color: rgba(21, 21, 36, .22); }
  .cp__panel--cream .btn-square--primary { background: #151524; }
  .cp__panel--cream .btn-square--secondary { color: #151524; border-color: rgba(21, 21, 36, .22); }
  .cp__row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .cp__pdf { font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; color: #4A4A5C; }
  .cp__btn-inv { background: #F2F1E8; color: #151524; }
  .cp__btn-inv:hover { opacity: .86; }
  .cp__btn-ghost { color: #F2F1E8; border-color: rgba(242, 241, 232, .24); }
  .cp__btn-ghost:hover { border-color: #F2F1E8; }
