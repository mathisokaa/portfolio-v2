---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
---
<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
  <section class="nf container">
    <div class="nf__txt">
      <span class="micro">Erreur 404 — hôte injoignable</span>
      <h1 class="h-display" data-rt>
        <span class="rl-wrap"><span class="rl" data-rl>Page introuvable.</span></span>
        <span class="rl-wrap"><span class="rl" data-rl>Retour au prompt.</span></span>
      </h1>
      <p class="lead">Cette page n'existe pas ou a été déplacée. Le reste de l'infra répond toujours.</p>
      <div class="nf__ctas">
        <a href="/" class="btn btn--primary">Retour à l'accueil <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a href="/projets" class="btn btn--secondary">Voir les projets</a>
      </div>
    </div>
    <div class="nf__tty" aria-hidden="true">
      <div class="nf__line"><span class="c-or">visiteur@homelab</span><span class="c-mute">:~$ </span>curl -I ce-lien</div>
      <div class="nf__line c-red">HTTP/1.1 404 Not Found</div>
      <div class="nf__line c-mute">→ la mascotte veille, le reste du site est en ligne.</div>
      <div class="nf__mascot"><Mascot px={6} /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: clamp(32px, 4vw, 56px);
    padding-top: clamp(48px, 8vw, 120px);
    padding-bottom: clamp(72px, 9vw, 120px);
  }
  .nf__txt { flex: 1 1 440px; display: flex; flex-direction: column; gap: 28px; }
  .nf__ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .nf__tty {
    flex: 1 1 400px;
    position: relative;
    min-height: 320px;
    padding: 24px;
    border-radius: 8px;
    background: #151524;
    color: #F2F1E8;
    box-shadow: var(--shadow-tty);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
  }
  .nf__mascot { position: absolute; right: 24px; bottom: 24px; }
  .c-or { color: #FF8204; }
  .c-mute { color: #A9A89F; }
  .c-red { color: #FA500F; }
</style>
