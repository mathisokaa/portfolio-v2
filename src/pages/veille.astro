---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelArt from '../components/PixelArt.astro';
import { TOPICS, TOPIC_KEYS, RADAR, SOURCES, RYTHME } from '../data/veille';
import { SITE } from '../data/site';

const entries = (await getCollection('veille')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) =>
  `${String(d.getUTCDate()).padStart(2, '0')}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${d.getUTCFullYear()}`;
const pad = (n: number, w = 2) => String(n).padStart(w, '0');
const updated = entries.length ? fmt(entries[0].data.date) : '—';
const total = entries.length;
const rendered = await Promise.all(
  entries.map(async (e, i) => ({ e, n: pad(total - i, 3), Content: (await render(e)).Content })),
);
// Sujets vides masqués
const topics = TOPIC_KEYS.map((k) => ({ k, ...TOPICS[k], count: entries.filter((e) => e.data.sujet === k).length })).filter((t) => t.count > 0);
const isExternal = (u: string) => /^https?:/.test(u);
---
<BaseLayout
  title="Veille"
  description="Journal de veille : ce que je lis, teste et retiens sur l'infra, la sécurité et l'auto-hébergement. Une entrée, une source, un avis."
  active="veille"
  footerLinks={[
    { href: '/', label: 'Accueil' },
    { href: '/projets', label: 'Projets' },
    { href: SITE.github, label: 'GitHub' },
    { href: '/#contact', label: 'Contact' },
  ]}
>
  <div class="vl" data-sujet="tous" data-veille-root>
    <script is:inline define:vars={{ keys: topics.map((t) => t.k) }}>
      (function () {
        var r = document.querySelector('[data-veille-root]');
        var q = new URLSearchParams(location.search).get('sujet');
        if (r && q && keys.indexOf(q) > -1) r.dataset.sujet = q;
      })();
    </script>

    <section class="vl__hero container">
      <div class="vl__row">
        <div class="vl__left">
          <span class="micro">Veille informatique — journal</span>
          <h1 class="vl__h1" data-rt>
            <span class="rl-wrap"><span class="rl" data-rl>Veille.</span></span>
            <span class="rl-wrap"><span class="rl" data-rl>Tenue à jour.</span></span>
          </h1>
          <p class="lead">Ce que je lis, teste et retiens sur l'infra, la sécurité et l'auto-hébergement. Une entrée, une source, un avis.</p>
        </div>
        <div class="vl__panel">
          <div class="vl__cells">
            <div class="vl__c vl__c--info"><span class="micro micro--cell vl__ink">Mise à jour</span><span class="vl__val">{updated}</span></div>
            <div class="vl__c"></div>
            <div class="vl__c"></div>
            <div class="vl__c vl__c--info vl__c--r"><span class="micro micro--cell vl__ink">Entrées</span><span class="vl__val">{pad(total)}</span></div>
            <div class="vl__c"></div>
            <div class="vl__c"></div>
            <div class="vl__c"></div>
            <div class="vl__c vl__c--r"></div>
            <div class="vl__c vl__c--b vl__c--end"><span class="micro micro--cell vl__white">Rythme · {RYTHME}</span></div>
            <div class="vl__c vl__c--b"></div>
            <div class="vl__c vl__c--b"></div>
            <div class="vl__c vl__c--b vl__c--r vl__c--end vl__c--right"><span class="micro micro--cell vl__white">{pad(SOURCES.length)} sources</span></div>
          </div>
          <div class="vl__arc" aria-hidden="true"></div>
          <span class="grain" aria-hidden="true"></span>
          <div class="vl__loupe" aria-hidden="true"><PixelArt art="loupe" variant="white" px={9} /></div>
        </div>
      </div>
    </section>

    <div class="vl__filters">
      <div class="vl__fin container" role="group" aria-label="Filtrer par sujet">
        <button type="button" class="vl__chip" data-chip="tous" aria-pressed="false"><span class="sq sq--6 vl__dot" style="--dot:var(--fg)"></span>Tout<span class="vl__n">{pad(total)}</span></button>
        {topics.map((t) => (
          <button type="button" class="vl__chip" data-chip={t.k} aria-pressed="false"><span class="sq sq--6 vl__dot" style={`--dot:${t.dot}`}></span>{t.label}<span class="vl__n">{pad(t.count)}</span></button>
        ))}
      </div>
    </div>

    <section class="vl__main container">
      <div class="vl__feed">
        <p class="sr-only" aria-live="polite" data-veille-status></p>
        {rendered.map(({ e, n, Content }) => (
          <article class="vl__art" data-entry={e.data.sujet}>
            <div class="vl__meta">
              <time class="vl__date" datetime={e.data.date.toISOString().slice(0, 10)}>{fmt(e.data.date)}</time>
              <span class="micro micro--cell">N° {n}</span>
            </div>
            <div class="vl__body">
              <span class="micro vl__topic"><span class="sq" style={`background:${TOPICS[e.data.sujet].dot}`}></span>{TOPICS[e.data.sujet].label}</span>
              <h2 class="vl__title">{e.data.titre}</h2>
              <div class="vl__take">
                <span class="micro micro--cell vl__takel">À retenir</span>
                <div class="vl__taket"><Content /></div>
              </div>
              <a href={e.data.url} class="vl__src" {...(isExternal(e.data.url) ? { rel: 'noopener', target: '_blank' } : {})}>
                {e.data.source} <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <aside class="vl__side" aria-label="Radar et sources">
        <div class="vl__radar">
          <div class="vl__rarc1" aria-hidden="true"></div>
          <div class="vl__rarc2" aria-hidden="true"></div>
          <div class="vl__rin">
            <div class="micro micro--cell vl__rhead"><span>Radar perso</span><span>{updated}</span></div>
            {RADAR.map((r) => (
              <div class="vl__ring">
                <span class="vl__ringl"><span class="sq" style={`background:${r.dot}`}></span>{r.ring}</span>
                <ul class="vl__items">{r.items.map((i) => <li>{i}</li>)}</ul>
              </div>
            ))}
          </div>
        </div>
        <div class="vl__sources">
          <h2 class="micro micro--cell vl__sh">Sources suivies</h2>
          <ul>
            {SOURCES.map((s) => (
              <li><span class="vl__sname">{s.name}</span><span class="micro micro--cell">{s.type}</span></li>
            ))}
          </ul>
        </div>
      </aside>
    </section>
  </div>
</BaseLayout>

<style>
  .vl[data-sujet]:not([data-sujet='tous']) .vl__art { display: none; }
  .vl[data-sujet='virtu'] .vl__art[data-entry='virtu'],
  .vl[data-sujet='secu'] .vl__art[data-entry='secu'],
  .vl[data-sujet='backup'] .vl__art[data-entry='backup'],
  .vl[data-sujet='conteneurs'] .vl__art[data-entry='conteneurs'],
  .vl[data-sujet='ia'] .vl__art[data-entry='ia'],
  .vl[data-sujet='windows'] .vl__art[data-entry='windows'],
  .vl[data-sujet='reglementaire'] .vl__art[data-entry='reglementaire'] { display: flex; }

  .vl__hero { padding-top: clamp(28px, 4vw, 56px); }
  .vl__row { display: flex; flex-wrap: wrap; gap: clamp(32px, 4vw, 56px); align-items: stretch; }
  .vl__left { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 24px; }
  .vl__h1 { font-size: clamp(56px, 7.4vw, 112px); font-weight: 500; line-height: .93; letter-spacing: -.045em; }
  .vl__panel {
    flex: 1 1 460px;
    min-width: 0;
    position: relative;
    min-height: 380px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--sunset-hero);
  }
  .vl__cells { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(3, 1fr); z-index: 2; }
  .vl__c { border-right: 1px solid rgba(255, 255, 255, .28); border-bottom: 1px solid rgba(255, 255, 255, .28); }
  .vl__c--r { border-right: 0; }
  .vl__c--b { border-bottom: 0; }
  .vl__c--info, .vl__c--end { padding: 12px; display: flex; flex-direction: column; justify-content: space-between; }
  .vl__c--end { justify-content: flex-end; }
  .vl__c--right { align-items: flex-end; }
  .vl__ink { color: #151524; }
  .vl__white { color: #FFFFFF; }
  .vl__val { font-family: var(--font-mono); font-size: 15px; letter-spacing: .02em; color: #151524; }
  .vl__arc { position: absolute; width: 640px; height: 640px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .4); right: -300px; bottom: -360px; }
  .vl__loupe { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; pointer-events: none; }

  .vl__filters {
    position: sticky;
    top: var(--nav-h);
    z-index: 40;
    background: var(--bg);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-top: clamp(48px, 6vw, 80px);
  }
  .vl__fin { padding-top: 12px; padding-bottom: 12px; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
  .vl__chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px;
    border-radius: 6px;
    border: 1px solid var(--line2);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .vl__chip:hover { border-color: var(--fg); }
  .vl__dot { background: var(--dot); }
  .vl__n { opacity: .7; }
  .vl__chip[aria-pressed='true'] { background: var(--btn); color: var(--btnfg); border-color: var(--btn); }
  .vl__chip[aria-pressed='true'] .vl__dot[style*='--fg'] { background: #FF8204; }

  .vl__main {
    padding-top: clamp(32px, 4vw, 56px);
    padding-bottom: clamp(72px, 9vw, 120px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 4vw, 64px);
    align-items: flex-start;
  }
  .vl__feed { flex: 2 1 600px; min-width: 0; display: flex; flex-direction: column; border-top: 1px solid var(--line2); }
  .vl__art { display: flex; flex-wrap: wrap; gap: 12px 32px; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .vl__meta { flex: 0 0 120px; display: flex; flex-direction: column; gap: 6px; padding-top: 4px; }
  .vl__date { font-family: var(--font-mono); font-size: 12px; letter-spacing: .06em; }
  .vl__body { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .vl__topic { display: flex; align-items: center; gap: 8px; }
  .vl__title { font-size: clamp(21px, 1.8vw, 25px); font-weight: 500; line-height: 1.2; letter-spacing: -.025em; text-wrap: balance; }
  .vl__take { display: flex; gap: 14px; padding: 14px 16px; background: var(--card); border: 1px solid var(--line); border-radius: 6px; }
  .vl__takel { flex: none; padding-top: 3px; }
  .vl__taket { font-size: 15px; line-height: 1.5; text-wrap: pretty; }
  .vl__taket :global(p) { margin: 0; }
  .vl__src {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: gap .3s var(--expo);
  }
  .vl__src:hover { gap: 14px; }
  .vl__src .arrow { font-size: 16px; }

  .vl__side { flex: 1 1 320px; min-width: 0; position: sticky; top: 140px; display: flex; flex-direction: column; gap: 16px; }
  @media (max-width: 1000px) { .vl__side { position: static; } }
  .vl__radar { position: relative; overflow: hidden; background: #151524; color: #F2F1E8; border-radius: 8px; padding: 22px; }
  .vl__rarc1, .vl__rarc2 { position: absolute; border-radius: 50%; border: 1px solid rgba(242, 241, 232, .14); }
  .vl__rarc1 { width: 440px; height: 440px; right: -220px; top: -220px; }
  .vl__rarc2 { width: 280px; height: 280px; right: -140px; top: -140px; }
  .vl__rin { position: relative; display: flex; flex-direction: column; gap: 18px; }
  .vl__rhead { display: flex; justify-content: space-between; color: #A9A89F; }
  .vl__ring { display: flex; flex-direction: column; gap: 10px; padding-top: 14px; border-top: 1px solid rgba(242, 241, 232, .12); }
  .vl__ringl { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .vl__items { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .vl__items li { font-size: 13px; padding: 6px 10px; border: 1px solid rgba(242, 241, 232, .18); border-radius: 4px; }
  .vl__sources { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 22px; display: flex; flex-direction: column; gap: 4px; }
  .vl__sh { margin-bottom: 10px; }
  .vl__sources ul { list-style: none; padding: 0; }
  .vl__sources li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-top: 1px solid var(--line); }
  .vl__sname { font-size: 15px; font-weight: 500; }
</style>

<script>
  function initVeille() {
    const root = document.querySelector<HTMLElement>('[data-veille-root]');
    if (!root) return;
    const status = root.querySelector<HTMLElement>('[data-veille-status]');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-chip]')];
    const keys = chips.map((c) => c.dataset.chip!);
    const q = new URLSearchParams(location.search).get('sujet');
    const set = (k: string, announce = false) => {
      root.dataset.sujet = k;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.chip === k)));
      if (announce && status) {
        const n = root.querySelectorAll(k === 'tous' ? '[data-entry]' : `[data-entry="${k}"]`).length;
        status.textContent = `${n} entrée${n > 1 ? 's' : ''} affichée${n > 1 ? 's' : ''}.`;
      }
    };
    set(q && keys.includes(q) ? q : 'tous');
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        const k = c.dataset.chip!;
        set(k, true);
        try {
          const u = new URL(location.href);
          if (k === 'tous') u.searchParams.delete('sujet');
          else u.searchParams.set('sujet', k);
          history.replaceState(history.state, '', u);
        } catch {}
      }),
    );
  }
  document.addEventListener('astro:page-load', initVeille);
</script>
