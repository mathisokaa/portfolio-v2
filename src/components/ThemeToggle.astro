---
// Bascule clair / sombre. Mémorisée en localStorage ; sans choix, suit prefers-color-scheme.
---
<button type="button" class="theme-toggle" data-theme-toggle aria-label="Basculer le thème sombre" aria-pressed="false">
  <span class="theme-toggle__icon" aria-hidden="true"></span>
</button>

<style>
  .theme-toggle {
    width: 40px;
    height: 40px;
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 6px;
    border: 1px solid var(--line2);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    transition: border-color .2s;
  }
  .theme-toggle:hover { border-color: var(--fg); }
  /* Carré mi-plein : moitié encre / moitié vide, en pixels */
  .theme-toggle__icon {
    position: relative;
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
  }
  .theme-toggle__icon::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 50%;
    background: currentColor;
  }
</style>

<script>
  function isDark() {
    const t = document.documentElement.dataset.theme;
    if (t) return t === 'dark';
    return matchMedia('(prefers-color-scheme: dark)').matches;
  }
  function initToggle() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      const sync = () => {
        const dark = isDark();
        b.setAttribute('aria-pressed', String(dark));
        b.setAttribute('aria-label', dark ? 'Activer le thème clair' : 'Activer le thème sombre');
      };
      sync();
      b.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        sync();
      });
    });
  }
  document.addEventListener('astro:page-load', initToggle);
</script>
