---
// Pixel art rendu au build (SVG, crispEdges). `hover` : gris → couleur au survol de [data-hover-host].
import { pixelSvg, type ArtName, type Ramp, type Variant } from '../lib/pixel';

interface Props {
  art: ArtName;
  ramp?: Ramp;
  variant?: Variant;
  px?: number;
  grid?: 'light' | 'dark' | boolean;
  hover?: boolean;
  label?: string;
  class?: string;
}
const { art, ramp, variant, px = 8, grid, hover = false, label, class: cls } = Astro.props;
const svg = pixelSvg(art, { ramp, variant, px, grid });
const classes = ['px', hover && 'px-hover', cls].filter(Boolean).join(' ');
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${svg.w} ${svg.h}`}
  width={svg.width}
  height={svg.height}
  shape-rendering="crispEdges"
  class={classes}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={svg.body}
/>

<style>
  .px { display: block; flex: none; max-width: none; }
</style>
