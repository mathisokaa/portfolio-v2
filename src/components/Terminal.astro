---
// Terminal interactif — pièce maîtresse. Logique : src/scripts/terminal.ts
import { SITE } from '../data/site';

interface Props { autoDemo?: boolean; class?: string }
const { autoDemo = true, class: cls } = Astro.props;
const config = {
  owner: SITE.name,
  email: SITE.email,
  linkedin: SITE.linkedinLabel,
  github: SITE.githubLabel,
  autoDemo,
};
---
<div class:list={['tty', cls]} data-tty data-config={JSON.stringify(config)}>
  <div class="tty__bar">
    <div class="tty__title">
      <span class="tty__dots" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>tty1 · ssh visiteur@homelab</span>
    </div>
    <div class="tty__status"><span class="tty__led" aria-hidden="true"></span><span data-tty-status>{autoDemo ? 'démo auto' : 'en ligne'}</span></div>
  </div>
  <div class="tty__out" data-tty-scroll>
    <div role="log" aria-live="polite" aria-label="Sortie du terminal" data-tty-log></div>
    <div class="tty__line tty__prompt-line" aria-hidden="true">
      <span class="c-or">visiteur@homelab</span><span class="c-mute">:~$ </span><span data-tty-echo></span><span class="tty__cursor" data-tty-cursor></span>
    </div>
  </div>
  <div class="tty__foot" aria-hidden="true">
    <span>Tab — compléter</span><span>↑ ↓ — historique</span><span>help — commandes</span>
  </div>
  <label class="tty__label">
    <span class="sr-only">Terminal : tapez une commande puis Entrée (help pour la liste, Échap pour quitter le terminal)</span>
    <input
      class="tty__input"
      data-tty-input
      type="text"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      enterkeyhint="send"
    />
  </label>
</div>

<style>
  .tty {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 340px;
    background: #151524;
    color: #F2F1E8;
    border-radius: 8px;
    border: 1px solid rgba(242, 241, 232, .12);
    box-shadow: var(--shadow-tty);
    overflow: hidden;
    font-family: var(--font-mono);
    cursor: text;
    text-align: left;
  }
  .tty:focus-within { box-shadow: var(--shadow-tty), 0 0 0 2px #0082E6; }
  .tty__bar, .tty__foot {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #A9A89F;
  }
  .tty__bar { justify-content: space-between; padding: 11px 16px; border-bottom: 1px solid rgba(242, 241, 232, .1); }
  .tty__title { display: flex; align-items: center; gap: 10px; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tty__dots { display: flex; gap: 4px; flex: none; }
  .tty__dots span { width: 8px; height: 8px; }
  .tty__dots span:nth-child(1) { background: #FA500F; }
  .tty__dots span:nth-child(2) { background: #FFAF01; }
  .tty__dots span:nth-child(3) { background: rgba(242, 241, 232, .25); }
  .tty__status { display: flex; align-items: center; gap: 8px; flex: none; }
  .tty__led { width: 6px; height: 6px; background: #44BA82; }
  .tty__out {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 18px 20px 14px;
    font-size: 13px;
    line-height: 1.7;
    scrollbar-width: thin;
    scrollbar-color: rgba(242, 241, 232, .2) transparent;
  }
  .tty__out :global(.tty__line) { white-space: pre-wrap; word-break: break-word; min-height: 1.7em; }
  .tty__prompt-line { word-break: break-all; }
  .tty__foot { flex-wrap: wrap; gap: 6px 18px; padding: 10px 16px; border-top: 1px solid rgba(242, 241, 232, .1); font-size: 10.5px; }
  .tty__cursor {
    display: inline-block;
    width: .62em;
    height: 1.2em;
    vertical-align: -.25em;
    box-shadow: inset 0 0 0 1px #F2F1E8;
  }
  .tty[data-on] .tty__cursor { background: #F2F1E8; animation: ttyblink 1.05s infinite; }
  @keyframes ttyblink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  .tty__input {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    border: 0;
    padding: 0;
    font-size: 16px; /* évite le zoom iOS */
  }
  .tty :global(.c-cream) { color: #F2F1E8; }
  .tty :global(.c-mute) { color: #A9A89F; }
  .tty :global(.c-or) { color: #FF8204; }
  .tty :global(.c-blue) { color: #55B3FB; }
  .tty :global(.c-amber) { color: #FEC63A; }
  .tty :global(.c-green) { color: #44BA82; }
  .tty :global(.c-red) { color: #FA500F; }
</style>

<script>
  import { mountTerminals } from '../scripts/terminal';
  document.addEventListener('astro:page-load', mountTerminals);
</script>
