---
// Carte projet : illustration 5/4 sur grille + corps. `stack` affiche les chips (page Projets).
import PixelArt from './PixelArt.astro';
import type { ArtName, Ramp } from '../lib/pixel';

interface Props {
  href: string;
  fig: string;
  legende: string;
  art: ArtName;
  ramp: Ramp;
  dot: string;
  categorie: string;
  titre: string;
  impact: string;
  pied: string;
  stack?: string[];
  px?: number;
  /** Fige l'état survol (planche composants) */
  forceHover?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}
const {
  href, fig, legende, art, ramp, dot, categorie, titre, impact, pied, stack, px = 11,
  forceHover = false, class: cls, ...rest
} = Astro.props;
---
<a href={href} class:list={['pc', { 'is-hover': forceHover }, cls]} data-hover-host {...rest}>
  <div class="pc__fig">
    <div class="grid-bg pc__grid"></div>
    <div class="arc pc__arc"></div>
    <span class="micro micro--cell pc__tl">{fig}</span>
    <span class="micro micro--cell pc__br">{legende}</span>
    <div class="pc__art"><PixelArt art={art} ramp={ramp} px={px} hover /></div>
  </div>
  <div class="pc__body">
    <div class="micro pc__cat"><span class="sq" style={`background:${dot}`}></span>{categorie}</div>
    <h3 class="pc__title">{titre}</h3>
    <p class="pc__impact">{impact}</p>
    {stack && stack.length > 0 && (
      <div class="pc__stack">{stack.map((s) => <span class="tag pc__tag">{s}</span>)}</div>
    )}
    <div class="pc__foot"><span>{pied}</span><span class="arrow" aria-hidden="true">→</span></div>
  </div>
</a>

<style>
  .pc {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    color: var(--fg);
    transition: transform .5s var(--expo), box-shadow .5s var(--expo);
  }
  .pc:hover, .pc:focus-visible, .pc.is-hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-float);
  }
  .pc:focus-visible { box-shadow: var(--shadow-float), var(--focus-ring); }
  .pc__fig {
    position: relative;
    aspect-ratio: 5 / 4;
    background: var(--soft);
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .pc__grid { background-size: 25% 20%; }
  .pc__arc { width: 120%; aspect-ratio: 1; left: 40%; top: -30%; }
  .pc__tl { position: absolute; left: 12px; top: 12px; }
  .pc__br { position: absolute; right: 12px; bottom: 12px; }
  .pc__art { position: relative; z-index: 1; }
  .pc__art :global(svg) { max-width: 100%; height: auto; }
  .pc__body { padding: 22px 24px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .pc__cat { display: flex; align-items: center; gap: 8px; }
  .pc__title {
    font-size: clamp(22px, 2vw, 27px);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.12;
    text-wrap: balance;
  }
  .pc__impact { color: var(--muted); font-size: 16px; line-height: 1.5; text-wrap: pretty; }
  .pc__stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .pc__tag { letter-spacing: .06em; border-color: color-mix(in srgb, var(--fg) 14%, transparent); }
  .pc__foot {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
</style>
