---
import { SITE } from '../../data/site';

const labels: Record<number, string> = { 3: 'SYN', 16: 'SYN-ACK', 29: 'ACK', 42: 'EST.' };
const cells = Array.from({ length: 96 }, (_, i) => ({ tint: i % 3 === 0 ? '#C4001D' : '#FFAF01', label: labels[i] ?? '' }));
---
<section id="contact" class="cta" aria-labelledby="cta-title">
  <div class="cta__cells" aria-hidden="true" data-wave>
    {cells.map((c) => (
      <div class="cta__cell">
        <div class="cta__tint" style={`background:${c.tint}`} data-cell></div>
        {c.label && <span class="micro micro--cell cta__lbl">{c.label}</span>}
      </div>
    ))}
  </div>
  <div class="cta__arc" aria-hidden="true"></div>
  <span class="grain" style="opacity:.55" aria-hidden="true"></span>
  <span class="micro cta__vert" aria-hidden="true">06 — Contact</span>
  <div class="cta__in container">
    <h2 id="cta-title" class="cta__title" data-rt>
      <span class="rl-wrap"><span class="rl" data-rl>Construisons</span></span>
      <span class="rl-wrap"><span class="rl" data-rl>votre infra.</span></span>
    </h2>
    <div class="cta__row">
      <div class="cta__btns">
        <a href={`mailto:${SITE.email}`} class="btn btn--lg cta__b1">Me contacter <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a href={SITE.cvPdf} download class="btn btn--lg cta__b2">Télécharger le CV</a>
      </div>
      <a href={`mailto:${SITE.email}`} class="cta__mail">{SITE.email}</a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; background: var(--sunset-cta); color: #FFFFFF; }
  .cta__cells {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    align-content: start;
  }
  .cta__cell {
    position: relative;
    aspect-ratio: 1;
    border-right: 1px solid rgba(255, 255, 255, .22);
    border-bottom: 1px solid rgba(255, 255, 255, .22);
  }
  .cta__tint { position: absolute; inset: 0; opacity: 0; }
  .cta__lbl { position: absolute; left: 8px; top: 7px; color: #151524; }
  .cta__arc {
    position: absolute;
    width: 1100px;
    height: 1100px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, .45);
    right: -380px;
    top: -520px;
  }
  .cta__vert {
    position: absolute;
    right: 14px;
    bottom: 20px;
    z-index: 2;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: #FFFFFF;
  }
  .cta__in {
    position: relative;
    z-index: 2;
    padding-top: clamp(160px, 18vw, 260px);
    padding-bottom: clamp(56px, 6vw, 88px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .cta__title {
    font-size: clamp(56px, 8.4vw, 136px);
    font-weight: 500;
    line-height: .92;
    letter-spacing: -.05em;
    color: #FFFFFF;
  }
  .cta__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .cta__b1 { background: #151524; color: #F2F1E8; }
  .cta__b1:hover { opacity: .88; }
  .cta__b2 { background: #FFFFFF; color: #151524; }
  .cta__b2:hover { opacity: .9; }
  .cta__mail { font-family: var(--font-mono); font-size: 13px; letter-spacing: .04em; color: #151524; }
  .cta__mail:hover { text-decoration: underline; text-underline-offset: 5px; }
</style>

<script>
  // Vague diagonale : chaque case s'allume en décalé selon (x + y).
  function wave() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-wave]').forEach((root) => {
      root.querySelectorAll<HTMLElement>('[data-cell]').forEach((c) => {
        const p = c.parentElement!;
        const d = (p.offsetLeft + p.offsetTop) / 120;
        c.animate([{ opacity: 0 }, { opacity: 0.5 }, { opacity: 0 }], {
          duration: 8000,
          delay: (-((20 - d) * 400) % 8000) - 8000,
          iterations: Infinity,
          easing: 'ease-in-out',
        });
      });
    });
  }
  document.addEventListener('astro:page-load', wave);
</script>
