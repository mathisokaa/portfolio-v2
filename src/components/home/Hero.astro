---
import Terminal from '../Terminal.astro';
import NewsCard from '../NewsCard.astro';
import { HERO_FACTS, NEWS } from '../../data/accueil';
---
<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__row">
    <div class="hero__left">
      <div class="hero__intro">
        <div class="micro hero__status"><span class="sq" style="background:#44BA82"></span>Administrateur systèmes — ouvert aux opportunités</div>
        <h1 id="hero-title" class="h-display" data-rt>
          <span class="rl-wrap"><span class="rl" data-rl>Infra solide.</span></span>
          <span class="rl-wrap"><span class="rl" data-rl>Sous contrôle.</span></span>
        </h1>
        <p class="lead">Je conçois, sécurise et opère des infrastructures Windows et Linux — en production chez les clients de mon ESN, et sur mon homelab réparti sur trois sites.</p>
        <div class="hero__ctas">
          <a href="#contact" class="btn btn--primary">Me contacter <span class="btn__arrow" aria-hidden="true">→</span></a>
          <a href="#projets" class="btn btn--secondary">Voir les projets</a>
        </div>
      </div>
      <dl class="hero__facts">
        {HERO_FACTS.map((f) => (
          <div class="hero__fact">
            <dt class="micro micro--cell">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero__panel">
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="hero__arc1" aria-hidden="true"></div>
      <div class="hero__arc2" aria-hidden="true"></div>
      <span class="grain" aria-hidden="true"></span>
      <span class="micro hero__lbl hero__lbl--tl" aria-hidden="true">Fig. 00 — Terminal</span>
      <span class="micro hero__lbl hero__lbl--tr" aria-hidden="true">Essayez : help</span>
      <span class="micro hero__lbl hero__lbl--v" aria-hidden="true">SSH · port 22 · session invitée</span>
      <div class="hero__tty"><Terminal /></div>
    </div>
  </div>

  <div class="hero__news">
    {NEWS.map((n) => <NewsCard {...n} />)}
  </div>
</section>

<style>
  .hero { padding-top: clamp(28px, 5vw, 64px); }
  .hero__row { display: flex; flex-wrap: wrap; gap: clamp(32px, 4vw, 56px); align-items: stretch; }
  .hero__left {
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    padding-top: clamp(0px, 2vw, 24px);
  }
  .hero__intro { display: flex; flex-direction: column; gap: 28px; }
  .hero__status { display: flex; align-items: center; gap: 10px; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .hero__facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .hero__fact {
    padding: 14px 16px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hero__fact dd { margin: 0; font-size: 14px; font-weight: 500; }

  .hero__panel {
    flex: 1.1 1 520px;
    min-width: 0;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: var(--sunset-hero);
    padding: clamp(56px, 6vw, 72px) clamp(16px, 3.4vw, 48px) clamp(20px, 3vw, 40px);
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, .2) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .2) 1px, transparent 1px);
    background-size: 80px 80px;
    background-position: -1px -1px;
  }
  .hero__arc1, .hero__arc2 { position: absolute; border-radius: 50%; }
  .hero__arc1 { width: 780px; height: 780px; border: 1px solid rgba(255, 255, 255, .4); right: -420px; top: -360px; }
  .hero__arc2 { width: 520px; height: 520px; border: 1px solid rgba(255, 255, 255, .28); left: -260px; bottom: -300px; }
  .hero__lbl { position: absolute; z-index: 2; color: #151524; }
  .hero__lbl--tl { left: 16px; top: 16px; }
  .hero__lbl--tr { right: 16px; top: 16px; }
  .hero__lbl--v { right: 14px; bottom: 18px; writing-mode: vertical-rl; transform: rotate(180deg); color: #FFFFFF; }
  .hero__tty { position: relative; z-index: 3; height: clamp(400px, 38vw, 470px); }

  .hero__news {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 12px;
    margin-top: clamp(32px, 4vw, 48px);
  }

  @media (max-width: 520px) {
    .hero__lbl--v { display: none; }
  }
</style>
